{
  "actorOutputSchemaVersion": 1,
  "title": "SiteSignal enrichment results",
  "description": "Successful website rows are in the default dataset. Failed/skipped URLs are nonbillable diagnostics. Observed contacts are not verified for deliverability.",
  "properties": {
    "results": {
      "type": "string",
      "title": "Enriched websites",
      "template": "{{links.apiDefaultDatasetUrl}}/items"
    },
    "csv": {
      "type": "string",
      "title": "Download spreadsheet-safe CSV",
      "template": "{{links.apiDefaultKeyValueStoreUrl}}/records/results.csv"
    },
    "crmCompaniesCsv": {
      "type": "string",
      "title": "Company fields for CRM mapping (safe CSV)",
      "template": "{{links.apiDefaultKeyValueStoreUrl}}/records/crm-companies.csv"
    },
    "crmCompaniesJson": {
      "type": "string",
      "title": "Company fields for CRM mapping (lossless JSON)",
      "template": "{{links.apiDefaultKeyValueStoreUrl}}/records/CRM_COMPANIES"
    },
    "contactsCsv": {
      "type": "string",
      "title": "All retained contacts and source pages (safe CSV)",
      "template": "{{links.apiDefaultKeyValueStoreUrl}}/records/contacts.csv"
    },
    "contactsJson": {
      "type": "string",
      "title": "All retained contacts and sources (lossless JSON)",
      "template": "{{links.apiDefaultKeyValueStoreUrl}}/records/CONTACTS"
    },
    "summary": {
      "type": "string",
      "title": "Run summary",
      "template": "{{links.apiDefaultKeyValueStoreUrl}}/records/SUMMARY"
    },
    "diagnostics": {
      "type": "string",
      "title": "Skipped and failed URLs",
      "template": "{{links.apiDefaultKeyValueStoreUrl}}/records/DIAGNOSTICS"
    },
    "report": {
      "type": "string",
      "title": "Complete JSON report",
      "template": "{{links.apiDefaultKeyValueStoreUrl}}/records/OUTPUT"
    }
  }
}

